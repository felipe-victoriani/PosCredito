{
  "rules": {
    // Tudo fechado por padrão: só o que estiver liberado abaixo funciona
    ".read": false,
    ".write": false,

    // ---------------------------------------------------------------
    // Perfis públicos: qualquer pessoa lê um perfil; só o dono escreve
    // ---------------------------------------------------------------
    "users": {
      "$uid": {
        ".read": true,
        // Só o dono, e o perfil não pode ser apagado
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['username', 'displayName', 'createdAt', 'stats'])",

        // @ imutável e obrigatoriamente reservado para este uid em usernames/
        // (o "." do @ vira "," na chave, porque chaves não aceitam ponto)
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20 && newData.val().matches(/^[a-z0-9._]+$/) && !newData.val().beginsWith('.') && !newData.val().endsWith('.') && !newData.val().contains('..') && (!data.exists() || data.val() === newData.val()) && newData.parent().parent().parent().child('usernames').child(newData.val().replace('.', ',')).val() === $uid"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 500"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        // Interesses: { tipos: { filme: true }, generos: { terror: true } }
        "interests": {
          "tipos": {
            "$tipo": { ".validate": "$tipo.matches(/^[a-z]+$/) && $tipo.length <= 20 && newData.val() === true" }
          },
          "generos": {
            "$genero": { ".validate": "$genero.matches(/^[a-z]+$/) && $genero.length <= 20 && newData.val() === true" }
          },
          "$outro": { ".validate": false }
        },
        // Data de criação: hora do servidor e imutável
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        // Contadores: nascem zerados e só andam de 1 em 1
        "stats": {
          ".validate": "newData.hasChildren(['followers', 'following', 'reviews', 'watched'])",
          // Seguidores: muda por quem segue/deixa de seguir, e só se a
          // entrada followers/{dono}/{quem escreve} mudar na mesma escrita
          "followers": {
            ".write": "auth != null && auth.uid !== $uid",
            ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() || (newData.val() === data.val() + 1 && newData.parent().parent().parent().parent().child('followers').child($uid).child(auth.uid).exists() && !root.child('followers').child($uid).child(auth.uid).exists()) || (newData.val() === data.val() - 1 && !newData.parent().parent().parent().parent().child('followers').child($uid).child(auth.uid).exists() && root.child('followers').child($uid).child(auth.uid).exists())))"
          },
          // Seguindo, reviews e vistos: só o dono, de 1 em 1
          "following": {
            ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() || (auth.uid === $uid && newData.val() >= 0 && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))))"
          },
          "reviews": {
            ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() || (auth.uid === $uid && newData.val() >= 0 && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))))"
          },
          "watched": {
            ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() || (auth.uid === $uid && newData.val() >= 0 && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))))"
          },
          "$outro": { ".validate": false }
        },
        "$outro": { ".validate": false }
      }
    },

    // ---------------------------------------------------------------
    // Reserva de @: leitura pública (busca de pessoas), cada @ só pode
    // ser reivindicado uma vez e sempre junto com o próprio perfil
    // ---------------------------------------------------------------
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString() && $username.length >= 3 && $username.length <= 20 && $username.matches(/^[a-z0-9_,]+$/) && !$username.matches(/^(admin|poscredito|poscreditos|suporte|moderacao|root|oficial)$/) && newData.parent().parent().child('users').child(auth.uid).child('username').val().replace('.', ',') === $username"
      }
    },

    // ---------------------------------------------------------------
    // Reviews: id = "{uid}_{mediaKey}" (uma por pessoa por título).
    // Toda escrita vem num update multi-path junto com titleReviews,
    // userReviews e titleStats; as regras exigem que tudo bata.
    // ---------------------------------------------------------------
    "reviews": {
      // Leitura pública da coleção: o feed "Em alta" lista por createdAt
      ".read": true,
      ".indexOn": ["createdAt"],
      "$reviewId": {
        // Só a dona escreve. Excluir exige baixar a estatística do título
        // e remover as entradas dos índices na mesma escrita.
        ".write": "auth != null && $reviewId.beginsWith(auth.uid + '_') && (!data.exists() || data.child('uid').val() === auth.uid) && (newData.exists() || (newData.parent().parent().child('titleStats').child(data.child('mediaKey').val()).child('ratingCount').val() === root.child('titleStats').child(data.child('mediaKey').val()).child('ratingCount').val() - 1 && !newData.parent().parent().child('titleReviews').child(data.child('mediaKey').val()).child($reviewId).exists() && !newData.parent().parent().child('userReviews').child(auth.uid).child($reviewId).exists()))",
        // Criar/editar: índices com a mesma data e estatística do título
        // ajustada exatamente pela diferença da nota
        // (usa o uid gravado, não auth.uid: curtir/comentar por outra pessoa
        // também passa por aqui e não pode quebrar esta checagem)
        ".validate": "newData.hasChildren(['uid', 'mediaKey', 'mediaType', 'title', 'tipo', 'rating', 'status', 'spoiler', 'text', 'createdAt', 'updatedAt', 'likeCount', 'commentCount']) && $reviewId === newData.child('uid').val() + '_' + newData.child('mediaKey').val() && newData.parent().parent().child('titleReviews').child(newData.child('mediaKey').val()).child($reviewId).val() === newData.child('createdAt').val() && newData.parent().parent().child('userReviews').child(newData.child('uid').val()).child($reviewId).val() === newData.child('createdAt').val() && newData.parent().parent().child('titleStats').child(newData.child('mediaKey').val()).child('ratingSum').val() === (root.child('titleStats').child(newData.child('mediaKey').val()).child('ratingSum').exists() ? root.child('titleStats').child(newData.child('mediaKey').val()).child('ratingSum').val() : 0) + newData.child('rating').val() - (data.exists() ? data.child('rating').val() : 0) && newData.parent().parent().child('titleStats').child(newData.child('mediaKey').val()).child('ratingCount').val() === (root.child('titleStats').child(newData.child('mediaKey').val()).child('ratingCount').exists() ? root.child('titleStats').child(newData.child('mediaKey').val()).child('ratingCount').val() : 0) + (data.exists() ? 0 : 1)",
        "uid": { ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === auth.uid" },
        "mediaKey": { ".validate": "newData.isString() && newData.val().matches(/^(movie|tv)_[0-9]+$/) && newData.val().length <= 20 && (!data.exists() || data.val() === newData.val())" },
        "mediaType": { ".validate": "newData.isString() && newData.val().matches(/^(movie|tv)$/) && newData.parent().child('mediaKey').val().beginsWith(newData.val() + '_')" },
        "title": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
        "tipo": { ".validate": "newData.isString() && newData.val().matches(/^(filme|serie|anime|dorama)$/)" },
        "posterPath": { ".validate": "newData.isString() && newData.val().length <= 64 && newData.val().matches(/^\\/[A-Za-z0-9_.-]+$/)" },
        "year": { ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]$/)" },
        // Nota de 0,5 a 5 em meias estrelas
        "rating": { ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 5 && (newData.val() * 2) % 1 === 0" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(assisti|reassisti|abandonei)$/)" },
        "spoiler": { ".validate": "newData.isBoolean()" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "updatedAt": { ".validate": "newData.val() === now" },
        // Curtidas: qualquer pessoa logada muda +1/-1, mas só junto com a
        // própria marca em likes/{review}/{uid} na mesma escrita
        "likeCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() || (newData.val() === data.val() + 1 && newData.parent().parent().parent().child('likes').child($reviewId).child(auth.uid).exists() && !root.child('likes').child($reviewId).child(auth.uid).exists()) || (newData.val() === data.val() - 1 && !newData.parent().parent().parent().child('likes').child($reviewId).child(auth.uid).exists() && root.child('likes').child($reviewId).child(auth.uid).exists())))"
        },
        // Comentários: +1/-1 (a regra de comments/ exige o contador junto)
        "commentCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() || newData.val() === data.val() + 1 || newData.val() === data.val() - 1))"
        },
        "$outro": { ".validate": false }
      }
    },

    // Índice: reviews de um título, valor = createdAt (ordenar por valor)
    "titleReviews": {
      "$mediaKey": {
        ".read": true,
        ".indexOn": ".value",
        "$reviewId": {
          ".write": "auth != null && $reviewId === auth.uid + '_' + $mediaKey && (newData.exists() || !newData.parent().parent().parent().child('reviews').child($reviewId).exists())",
          ".validate": "newData.isNumber() && newData.val() === newData.parent().parent().parent().child('reviews').child($reviewId).child('createdAt').val()"
        }
      }
    },

    // Índice: reviews de uma pessoa, valor = createdAt
    "userReviews": {
      "$uid": {
        ".read": true,
        ".indexOn": ".value",
        "$reviewId": {
          ".write": "auth != null && auth.uid === $uid && $reviewId.beginsWith($uid + '_') && (newData.exists() || !newData.parent().parent().parent().child('reviews').child($reviewId).exists())",
          ".validate": "newData.isNumber() && newData.val() === newData.parent().parent().parent().child('reviews').child($reviewId).child('createdAt').val()"
        }
      }
    },

    // Soma e contagem das notas de cada título. Só muda pela diferença
    // da review de quem está escrevendo (não dá para inflar a média).
    "titleStats": {
      "$mediaKey": {
        ".read": true,
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['ratingSum', 'ratingCount'])",
        "ratingSum": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() === (data.exists() ? data.val() : 0) + (newData.parent().parent().parent().child('reviews').child(auth.uid + '_' + $mediaKey).exists() ? newData.parent().parent().parent().child('reviews').child(auth.uid + '_' + $mediaKey).child('rating').val() : 0) - (root.child('reviews').child(auth.uid + '_' + $mediaKey).exists() ? root.child('reviews').child(auth.uid + '_' + $mediaKey).child('rating').val() : 0)"
        },
        "ratingCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() === (data.exists() ? data.val() : 0) + (newData.parent().parent().parent().child('reviews').child(auth.uid + '_' + $mediaKey).exists() ? 1 : 0) - (root.child('reviews').child(auth.uid + '_' + $mediaKey).exists() ? 1 : 0)"
        },
        "$outro": { ".validate": false }
      }
    },

    // ---------------------------------------------------------------
    // Seguir: follows/{quem}/{alvo} e followers/{alvo}/{quem} andam
    // juntos, com os dois contadores, numa única escrita
    // ---------------------------------------------------------------
    "follows": {
      "$uid": {
        ".read": true,
        "$alvo": {
          ".write": "auth != null && auth.uid === $uid && $alvo !== $uid && root.child('users').child($alvo).exists() && newData.exists() !== data.exists() && newData.parent().parent().parent().child('followers').child($alvo).child($uid).exists() === newData.exists() && newData.parent().parent().parent().child('users').child($uid).child('stats').child('following').val() === root.child('users').child($uid).child('stats').child('following').val() + (newData.exists() ? 1 : -1) && newData.parent().parent().parent().child('users').child($alvo).child('stats').child('followers').val() === root.child('users').child($alvo).child('stats').child('followers').val() + (newData.exists() ? 1 : -1)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "followers": {
      "$alvo": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.parent().parent().parent().child('follows').child($uid).child($alvo).exists() === newData.exists()",
          ".validate": "newData.val() === true"
        }
      }
    },

    // ---------------------------------------------------------------
    // Curtidas: uma por pessoa por review, sempre com o likeCount junto
    // ---------------------------------------------------------------
    "likes": {
      "$reviewId": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('reviews').child($reviewId).exists() && newData.exists() !== data.exists() && newData.parent().parent().parent().child('reviews').child($reviewId).child('likeCount').val() === root.child('reviews').child($reviewId).child('likeCount').val() + (newData.exists() ? 1 : -1)",
          ".validate": "newData.val() === true"
        }
      }
    },

    // ---------------------------------------------------------------
    // Comentários: criar (sem editar); apagar só quem escreveu ou a dona
    // da review. O commentCount vai sempre junto (+1 / -1).
    // ---------------------------------------------------------------
    "comments": {
      "$reviewId": {
        ".read": true,
        ".indexOn": ["createdAt"],
        "$commentId": {
          ".write": "auth != null && root.child('reviews').child($reviewId).exists() && (data.exists() ? (!newData.exists() && (data.child('uid').val() === auth.uid || root.child('reviews').child($reviewId).child('uid').val() === auth.uid)) : newData.exists()) && newData.parent().parent().parent().child('reviews').child($reviewId).child('commentCount').val() === root.child('reviews').child($reviewId).child('commentCount').val() + (newData.exists() ? 1 : -1)",
          ".validate": "newData.hasChildren(['uid', 'text', 'createdAt'])",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
          "createdAt": { ".validate": "newData.val() === now" },
          "$outro": { ".validate": false }
        }
      }
    },

    // ---------------------------------------------------------------
    // Listas pessoais (públicas no perfil; só a dona escreve)
    // ---------------------------------------------------------------
    "lists": {
      "$uid": {
        ".read": true,
        "$lista": {
          ".indexOn": ["addedAt"],
          "$mediaKey": {
            ".write": "auth != null && auth.uid === $uid && $lista.matches(/^(watchlist|watched|favorites)$/)",
            ".validate": "$mediaKey.matches(/^(movie|tv)_[0-9]+$/) && $mediaKey.length <= 20 && newData.hasChildren(['addedAt', 'title', 'tipo'])",
            "addedAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
            "title": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
            "tipo": { ".validate": "newData.isString() && newData.val().matches(/^(filme|serie|anime|dorama)$/)" },
            "posterPath": { ".validate": "newData.isString() && newData.val().length <= 64 && newData.val().matches(/^\\/[A-Za-z0-9_.-]+$/)" },
            "year": { ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]$/)" },
            "$outro": { ".validate": false }
          }
        }
      }
    }
  }
}
